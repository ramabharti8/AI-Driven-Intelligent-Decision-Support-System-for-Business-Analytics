# Copy to .env and change the values.
APP_ENV=development
# Required when APP_ENV=production. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173
# Set to 0 to skip training the models at startup (they then train on first request).
WARM_MODELS=1
